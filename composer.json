{
    "name": "edrisaturay/filament-azure-auth",
    "description": "Microsoft Entra ID sign-in for Filament panels.",
    "type": "library",
    "require": {
        "php": "^8.3",
        "dutchcodingcompany/filament-socialite": "^3.2.1",
        "filament/filament": "^5.0",
        "illuminate/support": "^12.0|^13.0",
        "socialiteproviders/microsoft-azure": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": { "EdrisaTuray\\FilamentAzureAuth\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "EdrisaTuray\\FilamentAzureAuth\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["EdrisaTuray\\FilamentAzureAuth\\AzureAuthServiceProvider"]
        }
    },
    "config": {
        "allow-plugins": { "pestphp/pest-plugin": true },
        "sort-packages": true
    },
    "scripts": { "test": "pest" }
}
